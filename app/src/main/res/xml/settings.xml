<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_cat_appearance">

        <ListPreference
            android:defaultValue="@string/text_size_medium_value"
            android:entries="@array/text_sizes"
            android:entryValues="@array/text_size_values"
            android:key="@string/pref_text_size"
            android:persistent="true"
            android:title="@string/pref_text_size_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/pref_expanded_by_default"
            android:persistent="true"
            android:summary="@string/pref_expanded_by_default_summary"
            android:title="@string/pref_expanded_by_default_title" />

        <MultiSelectListPreference
            android:defaultValue="@array/matlog_log_columns_default"
            android:entries="@array/matlog_log_columns"
            android:entryValues="@array/matlog_log_columns_values"
            android:key="@string/matlog_pref_log_columns"
            android:persistent="true"
            android:summary="@string/matlog_pref_log_columns_summary"
            android:title="@string/matlog_pref_log_columns_title" />

        <EditTextPreference
            android:defaultValue="@string/matlog_date_format_default"
            android:key="@string/matlog_pref_date_format"
            android:persistent="true"
            android:title="@string/matlog_pref_date_format_title" />

        <EditTextPreference
            android:defaultValue="@string/matlog_time_format_default"
            android:key="@string/matlog_pref_time_format"
            android:persistent="true"
            android:title="@string/matlog_pref_time_format_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_configuration">

        <MultiSelectListPreference
            android:defaultValue="@array/pref_buffer_choice_values_default"
            android:entries="@array/pref_buffer_choices"
            android:entryValues="@array/pref_buffer_choice_values"
            android:key="@string/pref_buffer"
            android:persistent="true"
            android:title="@string/pref_buffer_title" />

        <ListPreference
            android:defaultValue="@string/log_level_value_verbose"
            android:entries="@array/log_levels"
            android:entryValues="@array/log_levels_values"
            android:key="@string/pref_default_log_level"
            android:persistent="true"
            android:title="@string/pref_default_log_level_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/matlog_pref_filter_on_search"
            android:persistent="true"
            android:summary="@string/matlog_pref_filter_on_search_summary"
            android:title="@string/matlog_pref_filter_on_search_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/matlog_pref_cat_crashes">

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/matlog_pref_crash_detection"
            android:persistent="true"
            android:summary="@string/matlog_pref_crash_detection_summary"
            android:title="@string/matlog_pref_crash_detection_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:dependency="@string/matlog_pref_crash_detection"
            android:key="@string/matlog_pref_crash_notifications"
            android:persistent="true"
            android:summary="@string/matlog_pref_crash_notifications_summary"
            android:title="@string/matlog_pref_crash_notifications_title" />

        <SwitchPreference
            android:defaultValue="false"
            android:dependency="@string/matlog_pref_crash_detection"
            android:key="@string/matlog_pref_crash_monitor_service"
            android:persistent="true"
            android:summary="@string/matlog_pref_crash_monitor_service_summary"
            android:title="@string/matlog_pref_crash_monitor_service_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_advanced">

        <EditTextPreference
            android:defaultValue="@string/pref_log_line_period_default"
            android:key="@string/pref_log_line_period"
            android:persistent="true"
            android:summary="@string/pref_log_line_period_summary"
            android:title="@string/pref_log_line_period_title"
            android:inputType="numberDecimal"
            android:digits="0123456789"/>

        <EditTextPreference
            android:defaultValue="@string/pref_display_limit_default"
            android:key="@string/pref_display_limit"
            android:persistent="true"
            android:summary="@string/pref_display_limit_summary"
            android:title="@string/pref_display_limit_title" />

        <SwitchPreference
            android:key="scrubber"
            android:title="@string/scrubber"
            android:summary="@string/scrubber_summary"
            android:defaultValue="false"/>

    </PreferenceCategory>

</PreferenceScreen>
