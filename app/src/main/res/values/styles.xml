<resources>

    <style name="Theme.MatLog" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/omni_logo_color</item>
        <item name="android:dropDownListViewStyle">@style/DropDownListViewStyle</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.MatLog.Overlay" parent="ThemeOverlay.Material3Expressive.DynamicColors.DayNight">
    </style>

    <style name="Theme.MatLog.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="LogcatListItem" parent="@style/TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="fontFamily">monospace</item>
        <item name="lineHeight">@dimen/text_size_medium</item>
    </style>

    <style name="DropDownListViewStyle" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:scrollbars">none</item>
    </style>

    <style name="SecondaryFloatingActionButtonStyle" parent="Widget.Material3Expressive.FloatingActionButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3Expressive.FloatingActionButton.SecondaryContainer</item>
    </style>

    <style name="MatlogSearchBar" parent="Widget.Material3Expressive.SearchBar">
        <item name="android:layout_marginTop">@dimen/matlog_bar_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/matlog_bar_margin_vertical</item>
    </style>

    <style name="MatlogPillBar" parent="Widget.Material3.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/matlog_bar_height</item>
        <item name="android:layout_marginStart">@dimen/matlog_bar_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/matlog_bar_margin_horizontal</item>
        <item name="android:layout_marginTop">@dimen/matlog_bar_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/matlog_bar_margin_vertical</item>
        <item name="android:background">@drawable/bg_pill_bar</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
    </style>

    <style name="MatlogPillBar.Selection">
        <item name="android:background">@drawable/bg_pill_bar_selection</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.MatLog.SelectionBar</item>
        <item name="titleTextAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="titleTextColor">?attr/colorOnSecondaryContainer</item>
    </style>

    <style name="ThemeOverlay.MatLog.SelectionBar" parent="">
        <item name="colorControlNormal">?attr/colorOnSecondaryContainer</item>
        <item name="colorOnSurface">?attr/colorOnSecondaryContainer</item>
        <item name="colorOnSurfaceVariant">?attr/colorOnSecondaryContainer</item>
    </style>
</resources>
